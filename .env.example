# AI Search Journey Lab Environment Variables

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Google Maps / Places API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Settings
LOG_LEVEL=INFO

# Local BIGQUERY_PROJECT settings (Optional)
#BIGQUERY_PROJECT="ai-search-journey-lab"
#BIGQUERY_DATASET="ai_search_journey_v3"
#BIGQUERY_LOCATION="US"

# Bonus-B: Local Dockerized Observability (Grafana / Prometheus / Tempo / OTel Collector)
# Optional: Disabled by default. When set to OTel Collector HTTP endpoint, traces are exported.
#OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
#OTEL_SERVICE_NAME="ai_search_journey"
#OTEL_METRICS_ENABLED=true